{
  "name": "cpf-ajuste",
  "version": "1.0.0",
  "description": "Assistente local de validação e correção de CPF",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "br.com.cpfajuste.app",
    "productName": "CPF Ajuste",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  }
}
